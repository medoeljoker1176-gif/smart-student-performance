# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# NEVER commit secrets.toml. Generate each hash with:  python tools/make_password_hash.py <user> <role> "<name>"
# If this [auth] section is missing or has no valid users, the app runs WITHOUT login (demo mode).

[auth]
session_minutes = 30      # idle time before the user is logged out
max_attempts = 5          # wrong passwords before a username is locked
lockout_minutes = 5

[auth.users.teacher1]
role = "teacher"          # sees every page, batch upload and history
name = "Teacher demo"
password_hash = "pbkdf2_sha256$...paste the output of make_password_hash.py..."

[auth.users.student1]
role = "student"          # sees Prediction, AI Explanation, Recommendations, About
name = "Student demo"
password_hash = "pbkdf2_sha256$...paste the output of make_password_hash.py..."
